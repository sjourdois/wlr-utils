# English (fallback) UI strings for the wlr-peek tools.

overlay-region-hint = Drag to select · Esc to cancel
overlay-pick-hint = Click to pick · Esc to cancel
overlay-magnify-hint = Scroll to zoom · Esc to quit
loading = …
pip-gone = Source window closed
ocr-no-language = Tesseract has no language data for { $lang }: install it — the tesseract-ocr-<code> packages on Debian and Ubuntu, tesseract-data-<code> on Arch.
chooser-missing = Picking a window needs wlr-chooser, which is not installed: `cargo install wlr-chooser`, or install the wlr-utils suite.
