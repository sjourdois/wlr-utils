[Unit]
Description=wlr-draw — live on-screen annotation overlay (wlroots)
Documentation=https://github.com/sjourdois/wlr-utils
# Tie the daemon's lifetime to the Wayland graphical session (works with uwsm, which
# imports WAYLAND_DISPLAY into the user manager). For a non-systemd session, launch it
# from the compositor instead (e.g. sway `exec wlr-draw`).
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# systemd looks a bare name up in a fixed list (/usr/bin, /usr/local/bin…), never in
# PATH: env searches the user manager's PATH instead, so ~/.cargo/bin or ~/.local/bin
# work once the session imports it (uwsm does). env execs the daemon, which stays the
# main PID.
ExecStart=/usr/bin/env wlr-draw
# The journal would tag the output after env, the program systemd starts.
SyslogIdentifier=wlr-draw
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
