[Unit]
Description=wlr-overlayd — overlay daemon for wlr-switcher and wlr-chooser (wlroots)
Documentation=https://github.com/sjourdois/wlr-utils
# Tie the daemon's lifetime to the Wayland graphical session (works with uwsm, which
# imports WAYLAND_DISPLAY into the user manager). For a non-systemd session, launch it
# from the compositor instead (e.g. sway `exec_always wlr-overlayd`).
PartOf=graphical-session.target
After=graphical-session.target
# The daemon needs a compositor to connect to: don't start at all without one, rather
# than start, fail and be restarted.
Requisite=graphical-session.target

[Service]
Type=simple
# Relies on wlr-overlayd being on the user manager's PATH (~/.local/bin or /usr/bin).
ExecStart=wlr-overlayd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
